# Local `uv run simovi-mcp` binds loopback. Compose overrides environment and host.
SIMOVI_ENVIRONMENT=development
SIMOVI_HOST=127.0.0.1
SIMOVI_PORT=8000
SIMOVI_UPSTREAM_TIMEOUT_SECONDS=10

# Required by Compose / production: SHA-256 hex digest, NOT the plaintext token.
# Generate a high-entropy token in your password manager, then use the README's
# hidden-input command to write its digest. Never commit the original token.
# Leave unset for unauthenticated loopback-only development.
# SIMOVI_TOKEN_SHA256=

MCP_DOMAIN=mcp.simovi.org
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
